# PageIndex Cloud API key — create one at https://dash.pageindex.ai
# Required. Server-side only: it is never sent to the browser.
PAGEINDEX_API_KEY=

# Optional: point the app at another PageIndex-compatible backend.
# Defaults to https://api.pageindex.ai
# PAGEINDEX_API_URL=http://127.0.0.1:4319

# Optional: beta features requested when uploading a document.
# Default: block_reference (block ids + bboxes behind block-level citations).
# Set to empty or "none" to upload without beta features.
# PAGEINDEX_BETA_HEADERS=block_reference

# Your own model, used by the MCP lane (recommended).
# When set, chat runs as an agent over PageIndex's MCP tools instead of the
# legacy managed chat endpoint. Without it, the app falls back to managed chat.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: override the MCP endpoint (defaults to $PAGEINDEX_API_URL/mcp).
# PAGEINDEX_MCP_URL=https://api.pageindex.ai/mcp
